rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function room(code) { return get(/databases/$(db)/documents/rooms/$(code)).data; }
    function seatOk(s) { return s is map && s.keys().hasOnly(['name','color','joinedAt'])
      && s.name is string && s.name.size() <= 16 && s.color is string && s.color.size() <= 16; }

    match /profiles/{uid} {
      // get only: profiles can be looked up by uid but never listed
      allow get: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name','color','updatedAt','stats'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.color is string && request.resource.data.color.size() <= 16;
    }

    match /rooms/{code} {
      function n() { return request.resource.data; }
      // Room options fixed at creation (Catan mode/target/friendly, Pictionary secs/rounds); never changed later.
      function optsOk(o) { return o is map && o.size() <= 8
        && o.keys().hasOnly(['mode','target','friendly','secs','rounds'])
        && o.get('mode','base') in ['base','seafarers']
        && o.get('target',10) is int && o.get('target',10) >= 5 && o.get('target',10) <= 20
        && o.get('friendly',false) is bool
        && o.get('secs',60) is int && o.get('secs',60) in [45,60,90]
        && o.get('rounds',1) is int && o.get('rounds',1) in [1,2,3]; }
      function sd() { return n().seats.diff(resource.data.seats); }
      // Add only yourself while open and not full. The join that fills the last seat may also start the game.
      function joining() {
        return n().diff(resource.data).affectedKeys().hasOnly(['seats','status','startedAt'])
          && sd().addedKeys() == [me()].toSet() && sd().affectedKeys() == sd().addedKeys()
          && seatOk(n().seats[me()]) && n().seats.size() <= resource.data.maxSeats
          && (n().status == 'open' || (n().status == 'playing' && n().seats.size() == resource.data.maxSeats));
      }
      // A non-host removes only their own seat while the room is open.
      function leaving() {
        return me() != resource.data.host
          && n().diff(resource.data).affectedKeys().hasOnly(['seats'])
          && sd().removedKeys() == [me()].toSet() && sd().affectedKeys() == sd().removedKeys();
      }
      // The host starts early, with at least two seated.
      function starting() {
        return me() == resource.data.host && n().status == 'playing' && resource.data.seats.size() >= 2
          && n().diff(resource.data).affectedKeys().hasOnly(['status','startedAt']);
      }
      // get only: rooms are looked up by code, never listed
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[1-9][0-9]{5}')
        && n().keys().hasOnly(['game','v','host','seed','maxSeats','status','seats','createdAt','opts'])
        && n().game is string && n().host == me() && n().seed is int && n().status == 'open'
        && n().maxSeats is int && n().maxSeats >= 2 && n().maxSeats <= 8
        && (!('opts' in n()) || optsOk(n().opts))
        && n().seats.keys().hasOnly([me()]) && seatOk(n().seats[me()]);
      allow update: if signedIn() && resource.data.status == 'open' && (joining() || leaving() || starting());

      match /players/{uid} {
        function member() { let r = room(code); return signedIn() && me() == uid && r.status == 'playing' && uid in r.seats; }
        function shape() { return request.resource.data.keys().hasOnly(['setup','moves','turn'])
          && request.resource.data.get('moves', []) is list; }
        function appendOnly() { let o = resource.data.get('moves', []); let m = request.resource.data.get('moves', []);
          // m[0:0] raises an index error in rules, so an empty previous list is handled separately
          return m.size() >= o.size() && (o.size() == 0 || m[0:o.size()] == o); }
        function setupFixed() { return !('setup' in resource.data) || request.resource.data.setup == resource.data.setup; }
        // read includes list: the room's players are listed by watch()
        allow read: if signedIn();
        allow create: if member() && shape();
        allow update: if member() && shape() && appendOnly() && setupFixed();
      }

      // Pictionary drawing: append-only chunks {t, i, d}, id = <uid>_<turn>_<seq>. An identical re-send is allowed (idempotent retry).
      match /draw/{docId} {
        function inRoom() { let r = room(code); return signedIn() && r.status == 'playing' && me() in r.seats; }
        function chunkOk() { let x = request.resource.data;
          return x.keys().hasOnly(['t','i','d']) && x.t is int && x.t >= 0 && x.t < 100
            && x.i is int && x.i >= 0 && x.i < 100000 && x.d is string && x.d.size() <= 40000
            && docId == me() + '_' + string(x.t) + '_' + string(x.i); }
        allow read: if signedIn();
        allow create: if inRoom() && chunkOk();
        allow update: if inRoom() && chunkOk() && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
  }
}
